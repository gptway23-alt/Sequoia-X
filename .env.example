# 数据库路径（默认：data/sequoia_v2.db）
DB_PATH=data/sequoia_v2.db

# 数据起始日期（默认：2024-01-01）
START_DATE=2024-01-01

# BaoStock 连接保护：默认最多 2 个进程，每批 40 只，最多尝试 3 次
BAOSTOCK_MAX_WORKERS=2
BAOSTOCK_BATCH_SIZE=40
BAOSTOCK_MAX_ATTEMPTS=3
BAOSTOCK_BACKOFF_SECONDS=1.0
BAOSTOCK_SOCKET_TIMEOUT_SECONDS=20

# 当日有效行情覆盖率门槛；未达到时不发布数据、不运行策略、不发邮件
MIN_DAILY_COVERAGE=0.98

# 当日任务不得早于上海时间 15:30，避免收盘前行情被标记为当日完整数据
DAILY_SYNC_NOT_BEFORE=15:30

# Gmail 发件账号及应用专用密码
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# GMAIL_USER 是发件账号。报告固定同步发送给：
# 1044757346@qq.com、739152015@qq.com、gptway23@gmail.com
EMAIL_REPORT_DIR=reports

# 本次运行的机器可读状态；GitHub Actions 用它绑定当前运行与数据库导出
GPT_EXPORT_STATE_PATH=reports/gpt-export-state.json

# 已核验 GPT 数据库邮件：先压缩，单片 16 MiB，最多 24 片
# 每片和每个固定收件人均单独查询 Gmail SENT，临时失败最多重试一次
DATABASE_EMAIL_PACKAGE_DIR=reports/database-email
DATABASE_EMAIL_PART_BYTES=16777216
DATABASE_EMAIL_MAX_PARTS=24
# 本地运行数据库邮件 CLI 时可填写；GitHub Actions 会自动注入本次运行页面
DATABASE_DOWNLOAD_URL=https://github.com/owner/repository/actions/runs/123456789

# 默认飞书 Webhook URL（可选，仅在使用飞书通知时作为 fallback）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-default-token

# 策略专属 Webhook（可选，格式：STRATEGY_WEBHOOK_<策略标识>=<URL>）
# 未配置的策略将自动使用默认 FEISHU_WEBHOOK_URL
STRATEGY_WEBHOOK_MA_VOLUME=https://open.feishu.cn/open-apis/bot/v2/hook/your-ma-volume-token
STRATEGY_WEBHOOK_TURTLE=https://open.feishu.cn/open-apis/bot/v2/hook/your-turtle-token
STRATEGY_WEBHOOK_FLAG=https://open.feishu.cn/open-apis/bot/v2/hook/your-flag-token
STRATEGY_WEBHOOK_SHAKEOUT=https://open.feishu.cn/open-apis/bot/v2/hook/your-shakeout-token
STRATEGY_WEBHOOK_LIMIT_DOWN=https://open.feishu.cn/open-apis/bot/v2/hook/your-limit-down-token
STRATEGY_WEBHOOK_RPS=https://open.feishu.cn/open-apis/bot/v2/hook/your-rps-token
STRATEGY_WEBHOOK_PRIVATE_PLACEMENT=https://open.feishu.cn/open-apis/bot/v2/hook/your-private-placement-token
